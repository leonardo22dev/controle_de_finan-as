# ---------------------------------------------------------------
# Copie este arquivo para .env e preencha. NUNCA versione o .env.
# ---------------------------------------------------------------

# Quem interpreta as mensagens:
#   auto   -> usa o Claude se houver chave abaixo; senão cai no parser local
#   local  -> força o parser por regras. CUSTO ZERO, sem API, sem internet.
#   claude -> força o Claude (falha se não houver chave)
INTERPRETADOR=auto

# Opcional. Sem ela o bot funciona no modo local, só entendendo
# frases mais diretas. Pegue em: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Modelo usado para interpretar as mensagens.
# claude-opus-5      -> melhor qualidade (padrão)
# claude-haiku-4-5   -> mais barato e rápido, suficiente para lançamentos simples
ANTHROPIC_MODEL=claude-opus-5

# Caminho do banco SQLite (relativo à raiz do projeto).
DB_PATH=finance.db

# ---------------------------------------------------------------
# WhatsApp Cloud API — só necessário para rodar o servidor webhook.
# O modo CLI (python -m app.cli) funciona sem nada disso.
# ---------------------------------------------------------------

# Versão da Graph API. CONFIRA a versão atual e suportada em
# https://developers.facebook.com/docs/graph-api/changelog
# (versões antigas são descontinuadas depois de ~2 anos)
GRAPH_API_VERSION=v23.0

# Painel Meta > WhatsApp > API Setup
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# String que VOCÊ inventa. A Meta vai devolvê-la ao validar o webhook.
WHATSAPP_VERIFY_TOKEN=troque-por-uma-string-aleatoria

# Painel Meta > Configurações do app > Chave secreta do app.
# Usada para validar a assinatura HMAC de cada webhook recebido.
WHATSAPP_APP_SECRET=
